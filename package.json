{
  "name": "sentinel-intelligence",
  "version": "0.1.0",
  "private": true,
  "description": "Sentinel Intelligence — piattaforma OSINT, Cyber Threat Intelligence e Digital Investigations (MVP, Fase 1)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
