# =============================================================================
# Sentinel Intelligence — environment variables
# Copy to .env.local and fill in. NEVER commit real values.
# =============================================================================

# --- Supabase (required) ------------------------------------------------------
# Project Settings → API. The publishable key (sb_publishable_...) is safe for
# the browser: every query is still filtered by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Legacy projects can use the anon key instead of the publishable key:
# NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# --- Service role (NOT used by this version) --------------------------------
# The application never needs it. If a future server-only script requires it,
# keep it out of any NEXT_PUBLIC_ variable and out of the repository.
# SUPABASE_SERVICE_ROLE_KEY=

# --- Optional, server-side only (Phase 2 / Phase 5) ----------------------------
# Read only by server code; never stored in the database or sent to the browser.
VIRUSTOTAL_API_KEY=
OTX_API_KEY=
AI_PROVIDER_API_KEY=
